{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rodar a POC de clusterizacao",
      "type": "debugpy",
      "request": "launch",
      "module": "ibmecPCDV20261_victor_lucas_beatriz_ravi.poc_clusters",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    },
    {
      "name": "Rodar a POC baixando tudo de novo",
      "type": "debugpy",
      "request": "launch",
      "module": "ibmecPCDV20261_victor_lucas_beatriz_ravi.poc_clusters",
      "args": ["--baixar-tudo"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" }
    }
  ]
}
